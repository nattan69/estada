# Estada PMS — variables de entorno (copiar a .env para arranque local)

# Base de datos. SQLite por defecto (desarrollo). Postgres para producción:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/estada
DATABASE_URL=sqlite:///./estada.db

# CORS (lista JSON)
CORS_ORIGINS=["*"]

# Seguridad / JWT
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Bootstrap: usuario owner inicial (solo si la BD está vacía)
BOOTSTRAP_ADMIN_EMAIL=admin@estada.local
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-contrasenya
BOOTSTRAP_TENANT_NAME=Estada
BOOTSTRAP_TENANT_SLUG=estada

# Claves de integración (Fase 3)
POS_API_KEY=
ARIADNA_API_KEY=
OTA_API_KEY=

# VeriFactu
VERIFACTU_SOFTWARE_NAME=Estada PMS
VERIFACTU_SOFTWARE_VERSION=0.1.0
